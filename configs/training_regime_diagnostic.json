{
  "scope": "SOURCE VALIDATION DIAGNOSTIC ONLY",
  "models": ["ett", "emt", "ett_sr", "emt_sr"],
  "seeds": [42, 123, 2024],
  "optimizer": "AdamW",
  "lr": 0.001,
  "weight_decay": 0.0001,
  "batch_size": 128,
  "loss": "SmoothL1Loss",
  "smooth_l1_beta": 1.0,
  "gradient_clip": 5.0,
  "scheduler": null,
  "early_stopping": false,
  "checkpoint_selection": "last frozen epoch, never validation best",
  "epoch_config": "configs/final_training_epochs.json",
  "split_policy": "unchanged first-stage pedestrian manifest",
  "neighbor_policy": "unchanged clean social data: train-target-set-only train neighbors; observation-visible validation neighbors; N=8; no radius",
  "diagnostic_best_rule": "minimum validation ADE after training; FDE at the same epoch; independent minimum FDE also recorded",
  "correction_ratio_epsilon": 1e-8,
  "distance_bins": "no-neighbor; <2m; [2m,4m]; >4m",
  "correction_bins": "[0,0.05]; (0.05,0.10]; (0.10,0.20]; >0.20",
  "validation_rng_isolation": true,
  "training_workers": 4,
  "heldout_test_accessed": false,
  "historical_test_already_accessed": true
}
